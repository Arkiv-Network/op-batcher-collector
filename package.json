{
  "name": "@arkiv-network/op-batcher-collector",
  "version": "1.0.0",
  "description": "Bun collector for the admin_getThrottleController JSON-RPC method.",
  "type": "module",
  "main": "./dist/collector.js",
  "types": "./dist/collector.d.ts",
  "exports": {
    ".": {
      "types": "./dist/collector.d.ts",
      "import": "./dist/collector.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arkiv-Network/op-batcher-collector.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "bun dist/collector.js",
    "test": "npm run build && node --test test/*.node-test.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "typescript": "^5.8.3"
  }
}
